# Salin berkas ini menjadi .env (composer setup melakukannya sendiri). Baris yang diawali # adalah pilihan:
# hapus tanda # dan isi nilainya bila perlu. Nilai di bawah adalah bawaan untuk pengembangan lokal.

# --- Aplikasi ---
APP_NAME="STARTERKIT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Alamat aplikasi yang sebenarnya. Selain di environment local, aplikasi hanya menjawab host ini dan subdomainnya.
APP_URL=http://localhost:8000
# Kunci lama (dipisah koma) agar data terenkripsi tetap terbaca setelah APP_KEY diganti.
# APP_PREVIOUS_KEYS=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# --- Database (SQLite bawaan; berkasnya database/database.sqlite) ---
DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true
# Untuk MySQL: ganti DB_CONNECTION=mysql lalu isi baris berikut.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=starterkit
# DB_USERNAME=root
# DB_PASSWORD=

# --- Sesi (waktu dalam menit) ---
SESSION_DRIVER=database
# Diam selama ini, sesi berakhir.
SESSION_LIFETIME=15
# Umur terpanjang satu sesi, seaktif apa pun orangnya.
SESSION_ABSOLUTE_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SAME_SITE=lax
# Wajib true bila memakai HTTPS.
# SESSION_SECURE_COOKIE=true

# --- Cache, antrean, dan siaran ---
CACHE_STORE=database
# CACHE_PREFIX=
QUEUE_CONNECTION=database
# QUEUE_FAILED_DRIVER=database-uuids
BROADCAST_CONNECTION=log

# --- Redis (opsional, bila CACHE_STORE, QUEUE_CONNECTION, atau SESSION_DRIVER memakainya) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1

# --- Log ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
# LOG_DAILY_DAYS=14

# --- Surel (bawaan hanya menulis ke log) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Penyimpanan berkas ---
# local = folder storage/app/private. Layar Penyimpanan bisa menimpa S3 dan SFTP dengan isian dari layar.
FILESYSTEM_DISK=local

# Amazon S3 atau yang sejenis (isi AWS_ENDPOINT untuk MinIO).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_ENDPOINT=
# AWS_URL=

# SFTP.
SFTP_HOST=
# SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY=
SFTP_PASSPHRASE=
SFTP_HOST_FINGERPRINT=
# SFTP_ROOT=

# Host di jaringan internal (dipisah koma) yang boleh diisi dari layar Penyimpanan, misalnya MinIO.
# Host lain harus beralamat publik.
STORAGE_ALLOWED_HOSTS=

# --- Kata sandi ---
# Detik konfirmasi kata sandi berlaku untuk aksi sensitif (900 = 15 menit).
AUTH_PASSWORD_TIMEOUT=900
# Kata sandi berlaku sekian hari lalu wajib diganti.
PASSWORD_MAX_AGE_DAYS=30
# Kata sandi awal akun baru atau yang diatur ulang admin; pemiliknya wajib menggantinya saat masuk pertama.
# Isi di .env saja. Jangan simpan nilainya di berkas ini atau di git.
DEFAULT_USER_PASSWORD=

# --- Catatan audit ---
ACTIVITYLOG_ENABLED=true
# Catatan yang lebih tua dari ini (hari) dihapus oleh activitylog:clean (1826 = 5 tahun).
ACTIVITYLOG_CLEAN_AFTER_DAYS=1826
# ACTIVITYLOG_BUFFER_ENABLED=false

# --- Akun demo ---
# Membuat akun superadmin dan guest dengan kata sandi yang diketahui umum. Hanya untuk lokal.
SEED_DEMO_ACCOUNTS=true

# --- Frontend ---
VITE_APP_NAME="${APP_NAME}"

# --- Laravel Boost (aktif bila APP_ENV=local atau APP_DEBUG=true) ---
BOOST_ENABLED=true
BOOST_RULES_ENABLED=true
BOOST_RULES_SCOPED_GUIDELINES=false
BOOST_BROWSER_LOGS_WATCHER=true
BOOST_BROWSER_LOG_LEVELS=error,warning,info,debug
# Isi hanya bila deteksi otomatis memakai path yang salah.
# BOOST_PHP_EXECUTABLE_PATH=
# BOOST_COMPOSER_EXECUTABLE_PATH=
# BOOST_NPM_EXECUTABLE_PATH=
# BOOST_VENDOR_BIN_EXECUTABLE_PATH=
# BOOST_CURRENT_DIRECTORY_EXECUTABLE_PATH=
