APP_NAME=SIPEBRI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

ACTIVITYLOG_ENABLED=true
# Catatan audit lebih tua dari ini dihapus oleh activitylog:clean (5 tahun).
ACTIVITYLOG_CLEAN_AFTER_DAYS=1826

# Akun demo (superadmin dan guest) untuk lokal saja. Wajib mati di production.
SEED_DEMO_ACCOUNTS=true

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_ABSOLUTE_LIFETIME=720
# Wajib true di production (HTTPS).
# SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=idn
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SFTP_HOST=
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY=
SFTP_PASSPHRASE=
SFTP_HOST_FINGERPRINT=
# Internal hosts (comma separated) that the storage settings screen may connect to, such as a MinIO inside the network.
STORAGE_ALLOWED_HOSTS=

VITE_APP_NAME="${APP_NAME}"

# Laravel Boost: hanya aktif jika APP_ENV=local atau APP_DEBUG=true.
# Di production set BOOST_ENABLED=false.
BOOST_ENABLED=true
BOOST_RULES_ENABLED=true
BOOST_RULES_SCOPED_GUIDELINES=false
BOOST_BROWSER_LOGS_WATCHER=true
BOOST_BROWSER_LOG_LEVELS=error,warning,info,debug

# Isi hanya jika deteksi otomatis memakai path yang salah (misalnya beberapa versi PHP).
# BOOST_PHP_EXECUTABLE_PATH=
# BOOST_COMPOSER_EXECUTABLE_PATH=
# BOOST_NPM_EXECUTABLE_PATH=
# BOOST_VENDOR_BIN_EXECUTABLE_PATH=
# BOOST_CURRENT_DIRECTORY_EXECUTABLE_PATH=

# Passwords
# Seconds a confirmed password stays valid for sensitive actions (15 minutes).
AUTH_PASSWORD_TIMEOUT=900
# Password a new or reset account starts with; its owner must change it at the first sign-in. Set it in the real .env, never commit the value.
DEFAULT_USER_PASSWORD=
PASSWORD_MAX_AGE_DAYS=30
