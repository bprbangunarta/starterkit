{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "starterkit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/check-bundle.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write resources/js e2e email scripts playwright.config.ts eslint.config.js vite.config.js vitest.config.ts tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check resources/js e2e email scripts playwright.config.ts eslint.config.js vite.config.js vitest.config.ts tsconfig.json package.json .prettierrc.json",
    "standards": "node scripts/check-standards.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "error-pages": "tsx scripts/generate-error-pages.ts",
    "rebrand": "node scripts/rebrand.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run standards && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@laravel/vite-plugin-wayfinder": "^0.1.11",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "laravel-vite-plugin": "^3.2.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@inertiajs/react": "^3.11.0",
    "@inertiajs/vite": "^3.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.71.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  }
}
